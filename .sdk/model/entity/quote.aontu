      points: [
        {
          co: {
            id: "GET /api/quotes"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 12
                k: "query"
                n: "limit"
                or: "limit"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 0
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
